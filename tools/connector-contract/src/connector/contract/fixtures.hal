(ns connector.contract.fixtures)

(def passing-catalog
  {:kind :catalog
   :source (str
            "# Greenways repository catalog\n"
            "## Project\n"
            "https://github.com/orgs/greenways-ai/projects/2\n"
            "## Repository\n"
            "| Repository | Responsibility | Connector entry | Validation authority |\n"
            "## Responsibility\n"
            "Cross-repository workspace coordination.\n"
            "## Connector entry\n"
            "README.md and AGENTS.md.\n"
            "## Validation authority\n"
            "Root AGENTS.md and Makefile.\n")
   :links ["https://github.com/orgs/greenways-ai/projects/2"
           "https://github.com/greenways-ai/workspace"]
   :access :public
   :readiness :ready
   :validation-map {:status :documented
                    :commands ["make projects-test"]}
   :repositories
   [{:alias "workspace"
     :url "https://github.com/greenways-ai/workspace"
     :responsibility "Cross-repository workspace coordination."
     :connector-entry "README.md and AGENTS.md"
     :validation-authority "Root AGENTS.md and Makefile."
     :access :public
     :readiness :ready
     :validation-map {:status :documented
                      :commands ["make projects-test"]}}]})

(def passing-issue-form
  {:kind :issue-form
   :source (str
            "name: Agent-ready work contract\n"
            "body:\n"
            "  - type: textarea\n"
            "    id: outcome\n"
            "    attributes:\n"
            "      label: Outcome\n"
            "      description: A fresh agent can execute the issue.\n"
            "  - type: textarea\n"
            "    id: context\n"
            "    attributes:\n"
            "      label: Context and authority\n"
            "      description: GitHub issue 26 is authoritative.\n"
            "  - type: textarea\n"
            "    id: scope\n"
            "    attributes:\n"
            "      label: Scope\n"
            "      description: Implement the deterministic checker.\n"
            "  - type: textarea\n"
            "    id: acceptance\n"
            "    attributes:\n"
            "      label: Acceptance criteria\n"
            "      description: Findings are stable.\n"
            "  - type: textarea\n"
            "    id: validation\n"
            "    attributes:\n"
            "      label: Validation\n"
            "      description: Run the focused Hara test.\n"
            "  - type: textarea\n"
            "    id: relationships\n"
            "    attributes:\n"
            "      label: Relationships\n"
            "      description: Advances https://github.com/greenways-ai/workspace/issues/26.\n"
            "  - type: dropdown\n"
            "    id: readiness\n"
            "    attributes:\n"
            "      label: Readiness\n"
            "      description: Ready.\n"
            "  - type: textarea\n"
            "    id: delivery\n"
            "    attributes:\n"
            "      label: Delivery boundary\n"
            "      description: Owning repository: greenways-ai/workspace.\n")
   :links ["https://github.com/greenways-ai/workspace/issues/26"]
   :relationship "Advances https://github.com/greenways-ai/workspace/issues/26"
   :access :public
   :readiness :ready
   :validation-map {:status :documented
                    :commands ["hara --project . --offline run test/connector/contract/checker_test.hal"]}})

(def passing-pull-request
  {:kind :pull-request
   :source (str
            "## Primary issue\n"
            "https://github.com/greenways-ai/workspace/issues/26\n"
            "## Changes\n"
            "Added the native checker.\n"
            "## Reason\n"
            "Mechanical contract failures should be visible.\n"
            "## Validation\n"
            "Focused Hara tests pass.\n"
            "## Evidence\n"
            "Fresh-process output is stable.\n"
            "## Compatibility and risk\n"
            "No network or credential access.\n"
            "## Relationships\n"
            "Advances https://github.com/greenways-ai/workspace/issues/26.\n"
            "## Agent execution\n"
            "Native Hara runtime.\n"
            "## Remaining work\n"
            "Connector authorization remains outside this checker.\n")
   :links ["https://github.com/greenways-ai/workspace/issues/26"]
   :access :public
   :readiness :ready
   :validation-map {:status :documented
                    :commands ["hara --project . --offline run test/connector/contract/checker_test.hal"]}})

