sumed-reference]\n               (result/then\n                (result/all\n                 [(work/status runtime-after resumed-reference)\n                  (work/result runtime-after resumed-reference)\n                  (work/checkpoints runtime-after resumed-reference)\n                  (work/history runtime-after resumed-reference)])\n                (fn [resumed]\n                  (let [resumed-status (nth resumed 0)\n                        resumed-result (nth resumed 1)\n                        resumed-checkpoints (nth resumed 2)\n                        resumed-history (nth resumed 3)\n                        resumed-counts\n                        [(deref prepare-count) (deref finish-count)]]\n                    (result/then\n                     (work/fork runtime-after\n                                resumed-reference\n                                :finish\n                                {:id \"runtime-conformance-fork\"})\n                     (fn [fork-reference]\n                       (result/then\n                        (result/all\n                         [(work/status runtime-after fork-reference)\n                          (work/result runtime-after fork-reference)\n                          (work/checkpoints runtime-after fork-reference)\n                          (work/history runtime-after fork-reference)])\n                        (fn [forked]\n                          (runtime-corpus-result\n                           resumed-counts\n                           [(deref prepare-count) (deref finish-count)]\n                           status-before\n                           resumed-status\n                           resumed-result\n                           resumed-checkpoints\n                           resumed-history\n                           (nth forked 0)\n                           (nth forked 1)\n                           (nth forked 2)\n                           (nth forked 3))))))))))))))))))"} :ex/class :ex.class/hos