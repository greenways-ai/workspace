    total (count task-arguments)\n        options\n        (case total\n          0 {}\n          1 (let [value (first task-arguments)]\n              (if (map? value)\n                {:params value}\n                {:input value}))\n          2 {:input (nth task-arguments 0)\n             :params (nth task-arguments 1)}\n          3 {:input (nth task-arguments 0)\n             :params (nth task-arguments 1)\n             :environment (nth task-arguments 2)}\n          4 {:input (nth task-arguments 0)\n             :params (nth task-arguments 1)\n             :lookup (nth task-arguments 2)\n             :environment (nth task-arguments 3)}\n          (throw\n           (ex-info\n            \"Task invocation accepts at most input, params, lookup, and environment\"\n            {:arguments task-arguments})))]\n    (request\n     (if (empty? additional)\n       options\n       (assoc options :args additional)))))"} :ex/class :ex.class/internal :ex/code :hara/generic :expected/changes nil :expected/matches nil :legacy/cause nil :legacy/data "{:arguments task-arguments}" :legacy/error-code nil :legacy/message "\"Task invocation accepts at most input, params, lookup, and environment\"" :migration/batch nil :review/status :inferred :site/id ["hara-lang/hara" "core/lib/src/work/flow/task/engine.hal" "work.flow.task.engine/invocation-arguments" 0] :site/status :current :source/form "(ex-info\n            \"Task invocation accepts at most input, params, lookup, and environment\"\n            {:arguments task-arguments})" :source/modifiers [] :source/namespace work.flow.task.engine :source/path "core/lib/src/work/flow/task/engine.hal" :source/range {:column 12 :end-column 41 :end-line 193 :end-offset 6627 :line 191 :start-offset 6493} :source/repository "hara-lang/hara" :source/revision "a105106c2dadea7bcdc1820358dd03920a35d780" :source/role :production} {:classification/application nil :classification/base-type :ex.class/argument :classification/confidence :medium :classification/evidence "Matched ordered cues for :argument" :classification/rule :argument :classification/type :ex.class/argument :context/definition {:kind "defn" :name work.flow.task.engine/main-function :range {:column 1 :end-column 36 :end-line 271 :end-offset 8913 :line 254 :start-offset 8124} :source "(defn main-function\n  \"Adapts a Foundation-style main function with an explicit argument count.\n\n   The returned function always accepts input, params, lookup, environment,\n   and a vector of additional arguments.\"\n  [function count]\n  (case count\n    4 (fn [input params lookup environment arguments]\n        (apply function input params lookup environment arguments))\n    3 (fn [input params lookup environment arguments]\n        (apply function input params environment arguments))\n    2 (fn [input params lookup environment arguments]\n        (apply function input params arguments))\n    1 (fn [input params lookup environment arguments]\n        (apply function input arguments))\n    (throw\n     (ex-info \"Task main argcount must be between 1 and 4\"\n              {:argcount count}))))"} :ex/class :ex.class/argument :ex/code :hara/argument :expected/changes nil :expected/matches nil :legacy/cause nil :legacy/data "{:argcount count}" :legacy/error-code nil :legacy/message "\"Task main argcount must be between 1 and 4\"" :migration/batch nil :review/status :inferred :site/id ["hara-lang/hara" "core/lib/src/work/flow/task/engine.hal" "work.flow.task.engine/main-function" 0] :site/status :current :source/form "(ex-info \"Task main argcount must be between 1 and 4\"\n              {:argcount count})" :source/modifiers [] :source/namespace work.flow.task.engine :source/path "core/lib/src/work/flow/task/engine.hal" :source/range {:column 6 :end-column 33 :end-line 271 :end-offset 8910 :line 270 :start-offset 8824} :source/repository "hara-lang/hara" :source/revision "a105106c2dadea7bcdc1820358dd03920a35d780" :source/role :production} {:classification/applicatio