3))\n              (throw (ex-info \"package failed\" {:command argv :exit 1}))\n              {:command argv :exit 0 :stdout \"ok\" :stderr \"\"}))\n          runtime (work/durable-runtime)\n          reference\n          (work/start\n           runtime\n           deploy/package\n           {:selector :all\n            :packages +packages+\n            :executable \"./hara\"}\n           {:id \"deploy-package-error\"\n            :context {:process/run runner}})\n          output (work/result runtime reference)]\n      [(work/status runtime reference)\n       (get-in output [:summary :items])\n       (get-in output [:summary :results])\n       (get-in output [:summary :errors])\n       (record-packages (:records output))\n       (:package (first (:errors output)))])\n    [:completed\n     2\n     1\n     1\n     ['greenways/hodos-core 'greenways/hodos-authoring]\n     'greenways/hodos-authoring])\n\n   (test-check\n    \"deployment selectors remain data-first\"\n    (let [commands (atom [])\n          runner (fn [argv options]\n                   (do\n                     (swap! commands conj argv)\n                     {:command argv :exit 0 :stdout \"ok\" :stderr \"\"}))\n          output\n          (work/run\n           (work/local-runtime)\n           deploy/check\n           {:selector 'greenways/hodos-core\n            :packages +packages+\n            :executable \"./hara\"}\n           {:context {:process/run runner}})]\n      [(deref commands)\n       (:items output)\n       (record-packages (:records output))])\n    [[ [\"./hara\" \"package\" \"check\" \"packages/core\"]]\n     ['greenways/hodos-core]\n     ['greenways/hodos-core]])\n\n   (test-check\n    \"package catalogs reject dependency cycles\"\n    (try\n      (do\n        (deploy/ordered-packages\n         {'a {:path \"a\" :depends ['b]}\n          'b {:path \"b\" :depends ['a]}})\n        false)\n      (catch Throwable error true))\n    true)\n\n   (test-check\n    \"package catalog entries norm