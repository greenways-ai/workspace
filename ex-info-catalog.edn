cument/signed-record\")\n    [\"body\" \"signer-key\" \"signature\"]\n\n    true\n    (throw (ex-info \"unknown document ledger record kind\" {\"kind\" kind}))))"} :ex/class nil :ex/code nil :expected/changes nil :expected/matches nil :legacy/cause nil :legacy/data "{\"kind\" kind}" :legacy/error-code nil :legacy/message "\"unknown document ledger record kind\"" :migration/batch nil :review/status :pending :site/id ["greenways-ai/hestia" "gwdb-ledger-hal/src/gw/ledger/document_ot.hal" "gw.ledger.document-ot/record-fields" 0] :site/status :current :source/form "(ex-info \"unknown document ledger record kind\" {\"kind\" kind})" :source/modifiers [] :source/namespace gw.ledger.document-ot :source/path "gwdb-ledger-hal/src/gw/ledger/document_ot.hal" :source/range {:column 12 :end-column 73 :end-line 58 :end-offset 2119 :line 58 :start-offset 2058} :source/repository "greenways-ai/hestia" :source/revision "8b3418938e430bf002d9a324728d8ad30e45bb54" :source/role :production} {:context/definition {:kind "defn" :name gw.ledger.document-ot/transform-text-splice :range {:column 1 :end-column 23 :end-line 146 :end-offset 5284 :line 110 :start-offset 3583} :source "(defn transform-text-splice\n  [scalar-count incoming accepted]\n  (if (not (= (get incoming :target-id) (get accepted :target-id)))\n    incoming\n    (let [accepted-start (get accepted :offset)\n          accepted-delete (get accepted :delete-count)\n          accepted-end (+ accepted-start accepted-delete)\n          incoming-start (get incoming :offset)\n          incoming-delete (get incoming :delete-count)\n          incoming-end (+ incoming-start incoming-delete)\n          incoming-insert (inserted-length scalar-count incoming)]\n      (cond\n        (and (> accepted-delete 0)\n             (> incoming-insert 0)\n             (= incoming-delete 0)\n             (> incoming-start accepted-start)\n             (< incoming-start accepted-end))\n        (throw (ex-info \"insertion falls inside accepted deleted text\"\n                        {:code :text.insert-inside-deleted-range\n                         :incoming incoming\n                         :accepted accepted}))\n\n        (and (= accepted-delete 0)\n             (= incoming-delete 0)\n             (= incoming-start accepted-start))\n        (assoc incoming :offset\n               (+ incoming-start (inserted-length scalar-count accepted)))\n\n        true\n        (let [start (map-position scalar-count incoming-start accepted 1)\n              end (map-position scalar-count incoming-end accepted 1)\n              next (assoc (assoc incoming :offset (lower-number start end))\n                          :delete-count (upper-number 0 (- end start)))]\n          (if (and (= (get next :delete-count) 0)\n                   (= (inserted-length scalar-count next) 0))\n            (noop next \"overlapping deletion already accepted\")\n            next))))))"} :ex/class nil :ex/code nil :expected/changes nil :expected/matches nil :legacy/cause nil :legacy/data "{:code :text.insert-inside-deleted-range\n                         :incoming incoming\n                         :accepted accepted}" :legacy/error-code nil :legacy/message "\"insertion falls inside accepted deleted text\"" :migration/batch nil :review/status :pending :site/id ["greenways-ai/hestia" "gwdb-ledger-hal/src/gw/ledger/document_ot.hal" "gw.ledger.document-ot/transform-text-splice" 0] :site/status :current :source/form "(ex-info \"insertion falls inside accepted deleted text\"\n                        {:code :text.insert-inside-deleted-range\n                         :incoming incoming\n                         :accepted accepted})" :source/modifiers [] :source/namespace gw.ledger.document-ot :source/path "gwdb-ledger-hal/src/gw/ledger/document_ot.hal" :source/range {:column 16 :end-column 46 :end-line 130 :end-offset 4551 :line 127 :start-offset 4341} :source/repository "greenways-ai/hestia" :source/revision "8b3418938e430bf002d9a324728d8ad30e45bb54" :source